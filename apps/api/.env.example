# Copy to .env. Must match the values in the root .env:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
DATABASE_URL="postgresql://kindle_app:change-me@localhost:5432/kindle_pdf_reader"

# Signs login tokens. Anyone who has it can log in as any user: never commit or share it.
# Generate your own (at least 43 characters), each developer and server a different one:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=""
